{
  "version": "1",
  "templates": [
    {
      "type": 3,
      "title": "my-app",
      "description": "Tiny Python stdlib app, GHCR image, healthcheck, 128m/0.3c limits. Deploys as stack 'my-app' on :8088 (override PORTainer). Junior one-click, no CLI needed.",
      "categories": ["demo", "python", "ghcr"],
      "platform": "linux",
      "logo": "",
      "repository": {
        "url": "https://github.com/krazylearner/devops-stacks.git"
      },
      "stackfile": "stacks/my-app/compose.yaml",
      "env": [
        { "name": "TAG", "label": "Image tag (SHA or latest)", "default": "latest" },
        { "name": "APP_VERSION", "label": "App version label", "default": "v1" },
        { "name": "GIT_SHA", "label": "Git sha shown by /healthz", "default": "template" },
        { "name": "CONTAINER_NAME", "label": "Container name", "default": "my-app" },
        { "name": "HOST_PORT", "label": "Host port", "default": "8088" }
      ]
    },
    {
      "type": 3,
      "title": "my-app prev-stable (rollback)",
      "description": "One-click rollback preset: TAG=d1d810a last known healthy, deploys 'my-app-rollback' on :8093. Use when prod my-app-prod (:8092) is broken and you are junior with no CLI.",
      "categories": ["rollback", "dr"],
      "platform": "linux",
      "logo": "",
      "repository": {
        "url": "https://github.com/krazylearner/devops-stacks.git"
      },
      "stackfile": "stacks/my-app/compose.yaml",
      "env": [
        { "name": "TAG", "label": "Image tag (prev-stable)", "default": "d1d810a" },
        { "name": "APP_VERSION", "label": "App version label", "default": "prod" },
        { "name": "GIT_SHA", "label": "Git sha label", "default": "prod-stable" },
        { "name": "CONTAINER_NAME", "label": "Container name", "default": "my-app-rollback" },
        { "name": "HOST_PORT", "label": "Host port", "default": "8093" }
      ]
    }
  ]
}
